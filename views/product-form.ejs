<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Producto</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="card">
    <h1>Producto</h1>

    <form action="<%= action %>" method="POST">
      <label>Nombre
        <input type="text" name="name" value="<%= product.name || '' %>" required>
      </label>

      <label>Precio
        <input type="number" name="price" step="0.01" min="0"
               value="<%= product.price !== undefined ? product.price : '' %>" required>
      </label>

      <label>Stock
        <input type="number" name="stock" min="0"
               value="<%= product.stock !== undefined ? product.stock : '' %>" required>
      </label>

      <button type="submit">Guardar</button>
      <a class="btn btn-gray" href="/products">Cancelar</a>
    </form>
  </div>
</body>
</html>